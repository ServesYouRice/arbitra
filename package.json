{
  "name": "arbitra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm run test:lint-rules && pnpm run validate:examples && pnpm run design:check && pnpm run privacy:check",
    "privacy:check": "node --test tooling/privacy/check.test.mjs && node tooling/privacy/check.mjs",
    "design:check": "vitest run examples/design-check.test.ts",
    "lint": "eslint apps packages vitest.config.ts eslint.config.js --max-warnings 0",
    "test": "pnpm -r test",
    "validate:examples": "vitest run examples/validate.test.ts",
    "smoke:examples": "pnpm --filter @arbitra/runtime exec vitest run test/example-smoke.test.ts test/subscription-smoke.test.ts test/preflight.test.ts",
    "test:lint-rules": "node --test tooling/eslint-rules/test/*.test.cjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "package": "node tooling/package/build.mjs"
  },
  "pnpm": {
    "overrides": {
      "@fastify/ajv-compiler@<4.0.6": "^4.0.6",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "^4.2.3",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2"
    },
    "//": "Transitive advisories whose parents still allow vulnerable releases are forced here until their dependency ranges catch up. Remove an entry once the upstream range moves past it."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "esbuild": "0.27.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.12"
  }
}
