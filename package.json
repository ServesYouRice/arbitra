{
  "name": "arbitra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm run test:lint-rules && pnpm run validate:examples && pnpm run design:check",
    "design:check": "vitest run examples/design-check.test.ts",
    "lint": "eslint apps packages vitest.config.ts eslint.config.js --max-warnings 0",
    "test": "pnpm -r test",
    "validate:examples": "vitest run examples/validate.test.ts",
    "test:lint-rules": "node --test tooling/eslint-rules/test/*.test.cjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "overrides": {
      "@fastify/ajv-compiler@<4.0.6": "^4.0.6",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "fast-uri@>=4.0.0 <4.1.4": "^4.1.4",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18"
    },
    "//": "Transitive advisories whose parents still allow vulnerable releases are forced here until their dependency ranges catch up. Remove an entry once the upstream range moves past it."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
