{
  "name": "@arbitra/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench:traces": "ARBITRA_TRACE_BENCH=1 NODE_OPTIONS=--expose-gc vitest run test/trace-index.bench.test.ts --silent=false",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arbitra/core": "workspace:*",
    "@arbitra/harness": "workspace:*",
    "@arbitra/persistence": "workspace:*",
    "@arbitra/providers": "workspace:*",
    "@arbitra/protocols": "workspace:*",
    "@arbitra/schemas": "workspace:*",
    "@arbitra/security": "workspace:*",
    "@arbitra/tools": "workspace:*",
    "@arbitra/workflow": "workspace:*"
  },
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  }
}
