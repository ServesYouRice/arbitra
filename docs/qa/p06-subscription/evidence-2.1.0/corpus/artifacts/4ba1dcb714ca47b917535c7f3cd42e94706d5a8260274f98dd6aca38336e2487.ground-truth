{"groundTruthId":"premise-v1","items":[{"category":"authorization","detectionCriteria":"Recognizes that a user-controlled support header bypasses role enforcement.","id":"DEF-AUTH-BYPASS","kind":"defect","location":"authorize","path":"repo/src/auth.ts","rationale":"Authorization must derive from authenticated server-side identity, not a request header."},{"category":"performance","detectionCriteria":"Identifies one profile query per user inside the result loop.","id":"DEF-N-PLUS-ONE","kind":"defect","location":"listUsers","path":"repo/src/users.ts","rationale":"Query count grows linearly with result count and causes production latency/load."},{"category":"data_integrity","detectionCriteria":"Identifies the read-check-write sequence as non-atomic.","id":"DEF-RACE","kind":"defect","location":"reserve","path":"repo/src/inventory.ts","rationale":"Concurrent reservations can both pass the stock check and oversell."},{"category":"migration","detectionCriteria":"Identifies the non-null column addition without a safe backfill/default rollout.","id":"DEF-MIGRATION","kind":"defect","location":"ALTER TABLE","path":"repo/migrations/001_orders.sql","rationale":"Existing rows make this migration fail or require a long blocking rewrite."},{"category":"payments","detectionCriteria":"Identifies retrying capture without persisting or forwarding an idempotency key.","id":"DEF-IDEMPOTENCY","kind":"defect","location":"capturePayment","path":"repo/src/payments.ts","rationale":"A timeout followed by retry can charge the customer twice."},{"category":"security","detectionCriteria":"Does not report the constant-time signature comparison as a defect.","id":"DECOY-TIMING-SAFE","kind":"decoy","location":"verifySignature","path":"repo/src/decoys.ts","rationale":"Length is checked and timingSafeEqual is the correct comparison primitive."},{"category":"security","detectionCriteria":"Does not report SQL injection because the apparent user input is parameterized.","id":"DECOY-PARAMETERIZED-SQL","kind":"decoy","location":"findAccount","path":"repo/src/decoys.ts","rationale":"The query text is constant and the value is passed separately."},{"category":"reliability","detectionCriteria":"Does not report duplicate publication because the stable event ID is enforced by the sink.","id":"DECOY-IDEMPOTENT-RETRY","kind":"decoy","location":"publishOnce","path":"repo/src/decoys.ts","rationale":"Retrying with a stable unique key is deliberately idempotent."}],"version":1}