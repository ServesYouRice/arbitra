            "severity": "critical",
            "problem": "The function `readTenantFile` uses `node:path`'s `resolve` directly on `tenantRoot` and `requestedPath` without validating whether the resolved path escapes the `tenantRoot` directory. An attacker supplying relative path segments such as `../../etc/passwd` can read arbitrary files outside the tenant root.",
            "recommendedFix": "Use path containment validation similar to `readPublicAsset`, ensuring that the resolved candidate path strictly starts with `tenantRoot + sep`.",
            "locations": [
              {
                "path": "src/files.ts",
                "startLine": 3,
                "endLine": 5
              }
            ],
            "evidence": [
              {
                "text": "export function readTenantFile(tenantRoot: string, requestedPath: string): string {\n  return resolve(tenantRoot, requestedPath);\n}"
              }
            ]
