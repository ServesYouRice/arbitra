{"groundTruthId":"live-fixture-v1","items":[{"category":"correctness","detectionCriteria":"Identifies that applyDiscount accepts a percent outside 0-100, producing negative or inflated totals despite the documented range.","id":"discount-unbounded","kind":"defect","location":"applyDiscount","path":"src/cart.js","rationale":"The documented 0-100 contract is not enforced, so a caller-supplied percent can make a checkout total negative or larger than the subtotal."},{"category":"input_validation","detectionCriteria":"Identifies that parseQuantity returns NaN, truncated or negative values for customer text without validation.","id":"quantity-parse","kind":"defect","location":"parseQuantity","path":"src/cart.js","rationale":"parseInt(\"2.9\") is 2, parseInt(\"abc\") is NaN and parseInt(\"-3\") is -3; none is rejected before reaching cart arithmetic."},{"category":"authentication","detectionCriteria":"Identifies that isExpired treats a session as valid at exactly expiresAt, contradicting its documented strict expiry.","id":"session-expiry-boundary","kind":"defect","location":"isExpired","path":"src/session.js","rationale":"The comment says a session is valid strictly before its expiry instant, but now > expiresAt is false when now equals expiresAt."},{"category":"correctness","detectionCriteria":"Does not report subtotal as a defect.","id":"subtotal-correct","kind":"decoy","location":"subtotal","path":"src/cart.js","rationale":"subtotal sums price times quantity over the lines as documented, and the repository test covers it."}],"version":1}