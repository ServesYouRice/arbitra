{
  "schemaVersion": 1,
  "mode": "audit",
  "scope": {
    "kind": "repository"
  },
  "auditDepth": "deep",
  "consensusPolicy": "full",
  "maxConsensusRounds": 2,
  "verification": {
    "deterministicFirst": true,
    "maxModelQuestionsPerRound": 2
  },
  "models": {
    "auditor-a": {
      "schemaVersion": 1,
      "provider": "google",
      "modelId": "gemini-3.1-flash-lite",
      "transport": "gemini-native",
      "servedBy": null,
      "family": "gemini",
      "independenceGroup": "gemini-3.1-flash-lite",
      "capabilityTier": "frontier",
      "supports": {
        "tools": true,
        "parallelToolCalls": false,
        "structuredOutput": true,
        "reasoning": false,
        "promptCaching": false,
        "batch": false,
        "vision": false
      },
      "limits": {
        "contextTokens": 1000000,
        "maxOutputTokens": 65536
      },
      "effort": {
        "supported": [
          "low",
          "medium",
          "high"
        ],
        "collapse": {
          "xhigh": "high"
        },
        "params": {}
      },
      "quirks": {
        "systemPromptSupport": "full",
        "fewShotPolicy": "neutral",
        "promptStyle": "markdown",
        "documentPlacement": "leading",
        "historyPolicy": "round_trip_opaque",
        "samplingDefaults": {
          "temperature": null,
          "topP": null,
          "topK": null
        },
        "greedyDecodingSafe": true,
        "toolLoopLimit": 8,
        "prefillSupported": false
      },
      "structuredOutputDialect": "gemini"
    },
