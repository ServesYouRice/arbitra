  "harness": {
    "mode": "canonical"
  },
  "workflow": {
    "preset": "audit-deep",
    "modelExecution": {
      "endpoints": [
        {
          "id": "gemini-native",
          "providerId": "google",
          "transport": "gemini-native",
          "endpoint": "https://generativelanguage.googleapis.com/v1beta",
          "apiKeyEnvVar": "ARBITRA_GEMINI_API_KEY"
        },
        {
          "id": "gemini-native-b",
          "providerId": "google",
          "transport": "gemini-native",
          "endpoint": "https://generativelanguage.googleapis.com/v1beta",
          "apiKeyEnvVar": "ARBITRA_GEMINI_API_KEY"
        },
        {
          "id": "gemini-compatible",
          "providerId": "google-openai-compatible",
          "transport": "openai-chat",
          "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai",
          "apiKeyEnvVar": "ARBITRA_GEMINI_API_KEY"
        }
      ],
      "modelEndpoints": {
        "auditor-a": "gemini-native",
        "auditor-b": "gemini-native-b",
        "auditor-c": "gemini-compatible"
      },
      "roles": {
        "planner": "auditor-a",
        "verifier": "auditor-b",
        "critic": "auditor-c"
      },
      "maximumOutputTokens": 8000,
      "maximumContextTokens": 128000,
      "maximumTokens": 3000000,
      "timeoutMs": 180000,
      "maximumRetries": 5,
      "maximumOutputRepairs": 2,
      "rateLimits": {
        "google": {
          "rpm": 6,
          "tpm": 250000,
          "maxConcurrent": 1
        },
        "google-openai-compatible": {
          "rpm": 6,
          "tpm": 250000,
          "maxConcurrent": 1
        }
      }
    }
  },
