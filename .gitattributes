docs/** text eol=lf
# The glyph table is shipped verbatim: a test compares these two files byte for byte, so neither takes CRLF.
docs/brand/glyphs.ts text eol=lf
packages/schemas/src/glyphs.ts text eol=lf
# Screenshots and other images are binary evidence, never line-normalised.
*.jpg binary
*.jpeg binary
*.png binary
# Windows batch files need CRLF line endings; the macOS/Linux launcher needs LF.
*.cmd text eol=crlf
*.command text eol=lf
# A download of the repository as a zip carries no Git history; this file then names the commit it was made from.
tooling/launch/build-id export-subst
# Downloads (GitHub's zip of a branch) carry what builds and runs arbitra; the documentation and evidence stay in
# the repository. TESTERS.md and README.md stay in the download.
docs/** export-ignore
WORK-REMAINING.md export-ignore
