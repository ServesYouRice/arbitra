{
  "schemaVersion": 1,
  "mode": "audit",
  "scope": {
    "kind": "diff",
    "base": "origin/main",
    "head": "HEAD"
  },
  "auditDepth": "fast",
  "consensusPolicy": "minimal",
  "maxConsensusRounds": 0,
  "verification": {
    "deterministicFirst": true,
    "maxModelQuestionsPerRound": 0
  },
  "models": {
    "auditor-a": {
      "schemaVersion": 1,
      "provider": "openai",
      "modelId": "replace-with-your-model-id",
      "transport": "openai-responses",
      "servedBy": null,
      "family": "replace-with-your-model-family",
      "independenceGroup": "openai",
      "capabilityTier": "fast",
      "supports": {
        "tools": true,
        "parallelToolCalls": true,
        "structuredOutput": true,
        "reasoning": true,
        "promptCaching": true,
        "batch": false,
        "vision": false
      },
      "limits": {
        "contextTokens": null,
        "maxOutputTokens": null
      },
      "effort": {
        "supported": [
          "low",
          "medium"
        ],
        "collapse": {
          "high": "medium",
          "xhigh": "medium"
        },
        "params": {}
      },
      "quirks": {
        "systemPromptSupport": "full",
        "fewShotPolicy": "neutral",
        "promptStyle": "markdown",
        "documentPlacement": "leading",
        "historyPolicy": "strip_reasoning",
        "samplingDefaults": {
          "temperature": null,
          "topP": null,
          "topK": null
        },
        "greedyDecodingSafe": true,
        "toolLoopLimit": 8,
        "prefillSupported": false
      },
      "structuredOutputDialect": "openai_strict"
    }
  },
  "harness": {
    "mode": "canonical"
  },
  "workflow": {
    "preset": "diff-fast"
  },
  "budgets": {
    "maximumCostUsd": 2,
    "maximumModelCalls": 6
  },
  "security": {
    "excludeGlobs": [
      ".runs/**",
      "node_modules/**"
    ],
    "overlapBudget": 1
  },
  "protocols": {
    "audit": "1.0.0"
  },
  "promptOverrides": {},
  "contextPolicies": {
    "discovery": "independent"
  }
}
